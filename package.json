{
  "name": "tilatikki-server",
  "version": "1.0.0",
  "description": "Server component of the tilatikki-app",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "setup:project": "npm ci && npm --prefix client ci && npm --prefix client run build",
    "test:server": "vitest run --reporter=verbose",
    "test:client": "cd client && npm run test",
    "test": "npm run test:server && npm run test:client",
    "build": "npm --prefix client run build && tsc",
    "lint:server": "eslint . --ext .ts --report-unused-disable-directives --max-warnings 0",
    "lint:client": "cd client && npm run lint",
    "lint": "npm run lint:server && npm run lint:client",
    "dev": "cd client && npm run build && cd .. && tsx watch server/index.ts",
    "start": "node build/index.js",
    "seed:demo": "tsx server/seedDemo.ts",
    "typecheck": "tsc --noEmit && npm --prefix client run typecheck"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.2",
    "nodemailer": "^10.0.10"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.0",
    "@types/nodemailer": "^8.0.2",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^10.11.0",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "winston": "^3.19.0"
  }
}
